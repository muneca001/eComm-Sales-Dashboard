      <column caption='Price Range Label' datatype='string' datatype-customized='true' name='[Calculation_1116611247451979777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(INT([Calculation_1116611247453949954])) + &quot; – $&quot; + STR(INT([Calculation_1116611247454015491]))' />
      </column>
      <column caption='Bin Start' datatype='integer' name='[Calculation_1116611247453949954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([price] / 3) * 3' />
      </column>
      <column caption='Bin End' datatype='integer' name='[Calculation_1116611247454015491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([price] / 3) * 3 + 3' />
      </column>
      <column caption='Above Avg Sales' datatype='boolean' name='[Calculation_727049867289899008]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([price])&gt;=WINDOW_AVG(SUM([price]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='None' caption='Price (bin)' datatype='integer' name='[Price (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[price]' peg='0' size='3' />
      </column>
